@using PassManGUI.Models

<div class="panel-overlay @(IsVisible ? "visible" : "")" @onclick="Close"></div>

<div class="item-panel @(IsVisible ? "visible" : "")">
    <div class="panel-header">
        <h2>@(IsNewItem ? "New Item" : (IsEditMode ? "Edit Item" : "Item Details"))</h2>
        <div class="panel-actions">
            @if (!IsNewItem && !IsEditMode)
            {
                <button class="icon-btn" title="Edit" @onclick="EnableEdit">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                <button class="icon-btn danger" title="Delete" @onclick="ConfirmDelete">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            <button class="icon-btn" title="Close" @onclick="Close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    </div>
    
    <div class="panel-body">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/>
                </svg>
                <span>@ErrorMessage</span>
            </div>
        }
        
        @if (IsEditMode || IsNewItem)
        {
            <!-- Edit/Create Form -->
            <div class="form-group">
                <label for="itemTitle">Title *</label>
                <input type="text" id="itemTitle" @bind="editTitle" placeholder="e.g., Gmail Account" />
            </div>
            
            <div class="form-group">
                <label for="itemUsername">Username / Email</label>
                <input type="text" id="itemUsername" @bind="editUsername" placeholder="e.g., user@example.com" />
            </div>
            
            <div class="form-group">
                <label for="itemPassword">Password</label>
                <div class="password-input-group">
                    <input type="@(showPassword ? "text" : "password")" id="itemPassword" @bind="editPassword" placeholder="Enter password" />
                    <button type="button" class="toggle-password" @onclick="TogglePassword">
                        @if (showPassword)
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M1 1l22 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                    </button>
                </div>
            </div>
            
            <div class="form-group">
                <label for="itemUrl">Website URL</label>
                <input type="url" id="itemUrl" @bind="editUrl" placeholder="https://example.com" />
            </div>
            
            <div class="form-group">
                <label for="itemNotes">Notes</label>
                <textarea id="itemNotes" @bind="editNotes" rows="4" placeholder="Additional notes..."></textarea>
            </div>
        }
        else if (Item != null)
        {
            <!-- View Mode -->
            <div class="detail-group">
                <label>Title</label>
                <p class="detail-value">@Item.Title</p>
            </div>
            
            @if (!string.IsNullOrEmpty(Item.Username))
            {
                <div class="detail-group">
                    <label>Username / Email</label>
                    <div class="copyable-value">
                        <p>@Item.Username</p>
                        <button type="button" class="copy-btn" title="Copy" @onclick="() => CopyToClipboard(Item.Username)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
            
            <div class="detail-group">
                <label>Password</label>
                <div class="copyable-value password-value">
                    <p>@(showPassword ? "••••••••••••" : "••••••••••••")</p>
                    <button type="button" class="toggle-password" @onclick="TogglePassword">
                        @if (showPassword)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M1 1l22 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                    </button>
                    <button type="button" class="copy-btn" title="Copy password" @onclick="CopyPassword">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Item.Url))
            {
                <div class="detail-group">
                    <label>Website URL</label>
                    <div class="copyable-value">
                        <a href="@Item.Url" target="_blank" rel="noopener noreferrer">@Item.Url</a>
                        <button type="button" class="copy-btn" title="Copy" @onclick="() => CopyToClipboard(Item.Url)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(Item.Notes))
            {
                <div class="detail-group">
                    <label>Notes</label>
                    <p class="detail-value notes">@Item.Notes</p>
                </div>
            }
            
            <div class="detail-group metadata">
                <p>Created @Item.FormatTimeAgo()</p>
                @if (Item.LastAccessed.HasValue)
                {
                    <p>Last accessed @FormatDate(Item.LastAccessed.Value)</p>
                }
            </div>
        }
    </div>
    
    @if (IsEditMode || IsNewItem)
    {
        <div class="panel-footer">
            <button class="btn-secondary" @onclick="CancelEdit" disabled="@IsSaving">Cancel</button>
            <button class="btn-primary" @onclick="SaveItem" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-small"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>@(IsNewItem ? "Create Item" : "Save Changes")</span>
                }
            </button>
        </div>
    }
</div>

@if (showDeleteConfirm)
{
    <div class="delete-confirm-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="delete-confirm-dialog" @onclick:stopPropagation="true">
            <h3>Delete Item?</h3>
            <p>Are you sure you want to delete "@Item?.Title"? This cannot be undone.</p>
            <div class="dialog-actions">
                <button class="btn-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                <button class="btn-danger" @onclick="DeleteItem">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public VaultItemModel? Item { get; set; }
    [Parameter] public bool IsNewItem { get; set; }
    [Parameter] public int VaultId { get; set; }
    [Parameter] public EventCallback<VaultItemModel> OnSave { get; set; }
    [Parameter] public EventCallback<VaultItemModel> OnDelete { get; set; }
    
    private bool IsEditMode { get; set; }
    private bool IsSaving { get; set; }
    private bool showPassword { get; set; }
    private bool showDeleteConfirm { get; set; }
    private string ErrorMessage { get; set; } = "";
    
    // Edit form fields
    private string editTitle = "";
    private string editUsername = "";
    private string editPassword = "";
    private string editUrl = "";
    private string editNotes = "";
    
    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            if (IsNewItem)
            {
                // Reset for new item
                IsEditMode = true;
                editTitle = "";
                editUsername = "";
                editPassword = "";
                editUrl = "";
                editNotes = "";
            }
            else if (Item != null)
            {
                IsEditMode = false;
                editTitle = Item.Title;
                editUsername = Item.Username ?? "";
                editPassword = ""; // Don't populate password for security
                editUrl = Item.Url ?? "";
                editNotes = Item.Notes ?? "";
            }
            showPassword = false;
            ErrorMessage = "";
        }
    }
    
    private void EnableEdit()
    {
        IsEditMode = true;
    }
    
    private void CancelEdit()
    {
        if (IsNewItem)
        {
            _ = Close();
        }
        else
        {
            IsEditMode = false;
            // Reset form to original values
            if (Item != null)
            {
                editTitle = Item.Title;
                editUsername = Item.Username ?? "";
                editPassword = "";
                editUrl = Item.Url ?? "";
                editNotes = Item.Notes ?? "";
            }
        }
    }
    
    private async Task Close()
    {
        IsVisible = false;
        IsEditMode = false;
        showDeleteConfirm = false;
        await IsVisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }
    
    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
    
    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
    }
    
    private async Task DeleteItem()
    {
        if (Item != null)
        {
            await OnDelete.InvokeAsync(Item);
            showDeleteConfirm = false;
            await Close();
        }
    }
    
    private async Task SaveItem()
    {
        ErrorMessage = "";
        
        if (string.IsNullOrWhiteSpace(editTitle))
        {
            ErrorMessage = "Title is required";
            return;
        }
        
        IsSaving = true;
        
        try
        {
            var item = new VaultItemModel
            {
                Id = Item?.Id ?? 0,
                Title = editTitle.Trim(),
                Username = string.IsNullOrWhiteSpace(editUsername) ? null : editUsername.Trim(),
                Password = string.IsNullOrWhiteSpace(editPassword) ? null : editPassword,
                Url = string.IsNullOrWhiteSpace(editUrl) ? null : editUrl.Trim(),
                Notes = string.IsNullOrWhiteSpace(editNotes) ? null : editNotes.Trim(),
                VaultId = VaultId,
                CreatedAt = Item?.CreatedAt ?? DateTime.UtcNow
            };
            
            await OnSave.InvokeAsync(item);
            IsEditMode = false;
            
            if (IsNewItem)
            {
                await Close();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
    
    private async Task CopyToClipboard(string? text)
    {
        if (!string.IsNullOrEmpty(text))
        {
            // Note: In a real implementation, you'd use JS interop to copy to clipboard
            Console.WriteLine($"Would copy: {text}");
        }
    }
    
    private async Task CopyPassword()
    {
        // Note: Would need to fetch the actual password from API first
        Console.WriteLine("Would copy password");
    }
    
    private string FormatDate(DateTime date)
    {
        var timeSpan = DateTime.UtcNow - date;
        if (timeSpan.TotalDays > 365)
            return $"{(int)(timeSpan.TotalDays / 365)} years ago";
        if (timeSpan.TotalDays > 30)
            return $"{(int)(timeSpan.TotalDays / 30)} months ago";
        if (timeSpan.TotalDays > 1)
            return $"{(int)timeSpan.TotalDays} days ago";
        if (timeSpan.TotalHours > 1)
            return $"{(int)timeSpan.TotalHours} hours ago";
        if (timeSpan.TotalMinutes > 1)
            return $"{(int)timeSpan.TotalMinutes} minutes ago";
        return "just now";
    }
}
